{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "title": "Scene",
  "properties": {
    "id":        {"type": "string"},
    "lessonId":  {"type": "string"},
    "title":     {"type": "string"},
    "slug":      {"type": "string"},
    "videoUrl":  {"type": "string"},
    "steps": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {"order": {"type": "integer"}, "content": {"type": "string"}},
        "required": ["order", "content"]
      }
    },
    "verifyTip": {"type": "string"},
    "choices": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {"label": {"type": "string"}, "targetSceneId": {"type": "string"}},
        "required": ["label", "targetSceneId"]
      }
    },
    "criteria": {"type": "array", "items": {"type": "string"}}
  },
  "required": ["id", "lessonId", "slug", "videoUrl", "choices"]
}
